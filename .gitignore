node_modules/
npm-debug.log*

# Modpack gerado em runtime (DATA_DIR). É artefato, não fonte — a fonte é
# src/data/modpack.json. A barra inicial é obrigatória: sem ela o padrão
# casaria também com src/data/, e o manifesto nunca seria commitado.
/data/

# Segredos — NUNCA commitar
.env
.env.*
!.env.example

# Fonte do dossiê GsW (template + prints + build.ps1). O que o bot serve em
# /gsw é o HTML já montado em src/assets/gsw.html — esse SIM é versionado. Aqui
# ficam só os 138 KB de template e os prints soltos, que ninguém consome em
# runtime. A barra inicial evita casar com src/assets/gsw.html.
/gsw/
